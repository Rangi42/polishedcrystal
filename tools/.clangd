Documentation:
  CommentFormat: Markdown

CompileFlags:
  Add:
    - -DPROGRAM_NAME="dummy"
    - -DUSAGE_OPTS="dummy"
---
If:
  PathMatch: ".*\\.[ch]pp"
CompileFlags:
  Add:
    - -xc++
    - -std=c++17
    - -Wall
    - -Wextra
    - -pedantic
    - -Walloc-zero
    - -Wcast-align
    - -Wcast-qual
    - -Wduplicated-branches
    - -Wduplicated-cond
    - -Wfloat-equal
    - -Wformat=2
    - -Wformat-overflow=2
    - -Wformat-truncation=1
    - -Winline
    - -Wlogical-op
    - -Wnested-externs
    # - -Wno-sign-compare
    - -Wnull-dereference
    - -Wold-style-definition
    - -Wshadow
    - -Wshift-overflow=2
    - -Wstrict-overflow=2
    - -Wstrict-prototypes
    - -Wstringop-overflow=4
    - -Wundef
    - -Wuninitialized
    - -Wunused
    - -Wwrite-strings

---
If:
  PathMatch: ".*\\.[ch]"
CompileFlags:
  Add:
    - -xc
    - -std=c17
    - -Wall
    - -Wextra
    - -pedantic
    - -Walloc-zero
    - -Wcast-align
    - -Wcast-qual
    - -Wduplicated-branches
    - -Wduplicated-cond
    - -Wfloat-equal
    - -Wformat=2
    - -Wformat-overflow=2
    - -Wformat-truncation=1
    - -Winline
    - -Wlogical-op
    - -Wnested-externs
    # - -Wno-sign-compare
    - -Wnull-dereference
    - -Wold-style-definition
    - -Wshadow
    - -Wshift-overflow=2
    - -Wstrict-overflow=2
    - -Wstrict-prototypes
    - -Wstringop-overflow=4
    - -Wundef
    - -Wuninitialized
    - -Wunused
    - -Wwrite-strings
